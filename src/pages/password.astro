---
import '../styles/app.css';
---
<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ganti password · Akademi SAP</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style is:inline>[hidden]{display:none!important}
  .auth{min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:16px}
  .auth form{width:100%;max-width:380px}
  .auth h1{font-size:22px;margin:0 0 4px}
  .auth .inputs{grid-template-columns:1fr}
  .auth .err{color:var(--bad);font-size:14px;min-height:1.4em;margin:10px 0}
  .auth .err.ok{color:inherit}
  .auth .btn{width:100%}
</style>
</head>
<body>
<main class="auth">
  <form id="f" class="card" novalidate>
    <h1>Ganti password</h1>
    <div class="inputs">
      <label>Password lama<input name="current" type="password" autocomplete="current-password" required></label>
      <label>Password baru<input name="password" type="password" autocomplete="new-password" required minlength="8"></label>
      <label>Ulangi password baru<input name="again" type="password" autocomplete="new-password" required minlength="8"></label>
    </div>
    <p id="msg" role="alert" aria-live="polite" class="err"></p>
    <button id="go" class="btn" type="submit">Simpan</button>
    <p><a href="/">Kembali</a></p>
  </form>
</main>
<script is:inline>
  var f = document.getElementById('f'), msg = document.getElementById('msg'), go = document.getElementById('go');
  f.onsubmit = function (e) {
    e.preventDefault(); msg.textContent = ''; msg.className = 'err';
    if (f.password.value !== f.again.value) { msg.textContent = 'Password baru tidak sama'; return; }
    go.disabled = true;
    fetch('/api/password', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ current: f.current.value, password: f.password.value }) })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return [r.ok, d]; }); })
      .then(function (x) {
        if (x[0]) { msg.className = 'err ok'; msg.textContent = 'Password berhasil diganti.'; f.reset(); }
        else msg.textContent = x[1].error || 'Terjadi kesalahan';
        go.disabled = false;
      })
      .catch(function () { msg.textContent = 'Jaringan bermasalah'; go.disabled = false; });
  };
</script>
</body>
</html>
