---
import '../styles/app.css';
import { RGRP, ROLES, MODS, CATS } from '../../functions/_lib/catalog.js';
---
<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin · Akademi SAP</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style is:global>
  .admin{min-height:100dvh;display:flex;flex-direction:column;gap:16px;align-items:center;padding:32px 16px}
  .admin>*{width:100%;max-width:760px}
  .admin h1{font-size:22px;margin:8px 0 4px}
  .admin h2{font-size:18px;margin:0 0 10px}
  .admin .hint{font-size:14px;margin:0 0 14px;color:var(--meta)}
  .admin .meta{font-size:13px;color:var(--meta)}
  .admin .err{color:var(--bad);font-size:14px;min-height:1.4em;margin:10px 0 0}
  .back{font-size:14px;min-height:44px;display:flex;align-items:center}
  #gen{width:100%}
  #out{margin-top:14px;padding:14px;background:var(--chrome);border-radius:8px}
  #code{font:700 22px/1.3 var(--font-m);letter-spacing:.04em;user-select:all}
  #link{width:100%;font:16px var(--font-m);min-height:44px;padding:8px 10px;margin:4px 0 8px;border:1px solid var(--field);border-radius:8px}
  #until{margin-left:8px}
  .admin h2.sm{font-size:16px;margin:20px 0 6px}
  #list{list-style:none;padding:0;margin:0;font-size:14px}
  #list li{display:flex;justify-content:space-between;gap:8px;padding:8px 0;border-bottom:1px solid var(--line)}
  #list li span{color:var(--meta)}
  .arow{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;padding:12px 0;border-bottom:1px solid var(--line);font-size:15px;cursor:pointer}
  .arow .grow{flex:1 1 200px;min-width:0;overflow-wrap:anywhere}
  .arow .sub{font-size:13px;color:var(--meta)}
  .abadge{font-size:12px;font-weight:500;background:var(--band-blue);color:var(--deep);border-radius:4px;padding:1px 6px;margin-left:6px}
  .aedit{padding:16px;background:var(--chrome);border-radius:8px;margin:8px 0}
  .aedit fieldset{border:0;margin:12px 0;padding:0;min-width:0}
  .aedit legend{font-weight:500;font-size:15px;color:var(--ink);margin-bottom:6px;padding:0}
  .aedit label{display:flex;gap:10px;align-items:center;min-height:40px;font-size:15px;padding:4px 0;overflow-wrap:anywhere}
  .aedit input[type=checkbox]{width:18px;height:18px;flex:none;accent-color:var(--accent)}
  .aedit select{max-width:100%;font-size:16px;min-height:44px;padding:8px 10px;border:1px solid var(--field);border-radius:8px;background:var(--bg)}
  .aedit .grp{font-size:13px;color:var(--meta);margin:10px 0 2px}
  .aedit .from{font-size:13px;color:var(--meta)}
  .aedit .st{font-size:14px;margin-left:8px}
  .arow .btn{white-space:nowrap}
  .ncount{display:inline-grid;place-items:center;min-width:22px;height:22px;padding:0 7px;margin-left:8px;border-radius:999px;background:var(--bad);color:#fff;font-size:13px;vertical-align:2px}
  .ncount:empty{display:none}
  .admin h3{font-size:15px;margin:16px 0 4px}
  .admin form.inl{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end}
  .admin form.inl label{display:flex;flex-direction:column;gap:4px;font-size:14px;color:var(--meta);flex:1 1 160px}
  .admin form.inl input{min-height:44px;padding:8px 10px;font-size:16px;border:1px solid var(--field);border-radius:8px;background:var(--bg);color:var(--ink)}
  .admin form.inl .btn{margin:0}
  .done{opacity:.6}
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px;margin:0 0 12px}
  .stats div{padding:10px 12px;background:var(--bg);border-radius:8px}
  .stats b{display:block;font-size:18px;color:var(--ink)}
  .stats span{font-size:13px;color:var(--meta)}
  .xtbl{width:100%;border-collapse:collapse;font-size:14px;margin:0 0 12px}
  .xtbl td{padding:6px 0;border-bottom:1px solid var(--line)}
  .xtbl td+td{text-align:right;font-variant-numeric:tabular-nums}
  @media (max-width:600px){.admin form.inl .btn{width:100%}.arow .btn{flex:1 1 0}.aedit .btn,#copy{width:100%}#until{display:block;margin:8px 0 0}.aedit .st{display:block;margin:8px 0 0}}
</style>
</head>
<body>
<script is:inline type="application/json" id="catalog" set:html={JSON.stringify({ RGRP, ROLES, MODS, CATS })}></script>
<main class="admin">
  <a class="back" href="/">← Kembali ke aplikasi</a>
  <div id="denied" hidden><p>Halaman ini khusus admin.</p></div>
  <section class="card">
    <h1>Kode undangan</h1>
    <p class="hint">Setiap kode hanya bisa dipakai 1 orang dan hangus setelah 30 menit.</p>
    <div id="panel" hidden>
      <button id="gen" class="btn" type="button">Buat kode baru</button>
      <div id="out" hidden>
        <div class="meta">Kode</div>
        <div id="code"></div>
        <div class="meta">Link daftar (kirim ke peserta)</div>
        <input id="link" readonly aria-label="Link daftar" onfocus="this.select()">
        <button id="copy" class="btn" type="button">Salin link</button>
        <span id="until" class="meta"></span>
      </div>
      <h2 class="sm">Kode aktif</h2>
      <ul id="list"></ul>
    </div>
    <p id="msg" role="alert" aria-live="polite" class="err"></p>
  </section>
  <section id="reqCard" class="card" hidden>
    <h2>Notifikasi <span id="ncount" class="ncount"></span></h2>
    <p class="hint">Diperbarui otomatis setiap 30 detik.</p>
    <h3>Permintaan akses (keranjang add-on)</h3>
    <div id="reqs"></div>
    <h3>Penukaran reward & kupon</h3>
    <div id="rdms"></div>
  </section>
  <section id="cpnCard" class="card" hidden>
    <h2>Kupon</h2>
    <p class="hint">Peserta memasukkan kode di halaman EXP & Reward. Koin dipotong sesuai harga; tiap kode hanya bisa dipakai sekali.</p>
    <form id="cpnForm" class="inl">
      <label>Reward<input id="cpnReward" maxlength="120" required placeholder="Contoh: Mentoring 30 menit"></label>
      <label style="flex:0 1 120px">Harga (koin)<input id="cpnCost" type="number" inputmode="numeric" min="0" max="100000" step="1" required value="0"></label>
      <label>Kode (opsional)<input id="cpnCode" maxlength="32" placeholder="Otomatis bila kosong" style="text-transform:uppercase"></label>
      <button class="btn">Buat kupon</button>
    </form>
    <div id="cpns"></div>
  </section>
  <section id="waCard" class="card" hidden>
    <h2>WhatsApp admin</h2>
    <p class="hint">Dipakai untuk checkout keranjang dan klaim reward. Kosongkan untuk mematikan.</p>
    <form id="waForm" class="inl">
      <label>Nomor WhatsApp<input id="waNum" inputmode="tel" autocomplete="tel" placeholder="08xxxxxxxxxx"></label>
      <button class="btn">Simpan</button>
    </form>
    <p id="waSt" class="meta" role="status"></p>
  </section>
  <section id="usrCard" class="card" hidden>
    <h2>Pengguna</h2>
    <div id="usrs"></div>
  </section>
</main>
<script is:inline>
  var $ = function (id) { return document.getElementById(id); };
  var hhmm = function (t) { return new Date(t).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }); };
  var link = function (c) { return location.origin + '/login?invite=' + c; };
  function api(method) {
    return fetch('/api/invites', { method: method, credentials: 'same-origin' }).then(function (r) {
      if (r.status === 401) { location.href = '/login'; throw 0; }
      if (r.status === 403) { $('denied').hidden = false; $('panel').hidden = true; throw 0; }
      if (!r.ok) throw new Error();
      return r.json();
    });
  }
  function fail(e) { if (e !== 0) $('msg').textContent = (e && e.message) || 'Terjadi kesalahan, coba lagi'; }
  function load() {
    return api('GET').then(function (d) {
      $('panel').hidden = false;
      var ul = $('list'); ul.textContent = '';
      if (!d.invites.length) { var li = document.createElement('li'); li.textContent = 'Belum ada.'; li.className = 'meta'; ul.append(li); }
      d.invites.forEach(function (i) {
        var li = document.createElement('li');
        var c = document.createElement('code'); c.textContent = i.code;
        var t = document.createElement('span'); t.textContent = 's.d. ' + hhmm(i.expires);
        li.append(c, t); ul.append(li);
      });
    }).catch(fail);
  }
  $('gen').onclick = function () {
    $('gen').disabled = true; $('msg').textContent = '';
    api('POST').then(function (d) {
      $('code').textContent = d.code; $('link').value = link(d.code);
      $('until').textContent = 'Berlaku s.d. ' + hhmm(d.expires);
      $('copy').textContent = 'Salin link'; $('out').hidden = false;
      return load();
    }).catch(fail).then(function () { $('gen').disabled = false; });
  };
  $('copy').onclick = function () {
    navigator.clipboard.writeText($('link').value).then(function () { $('copy').textContent = 'Tersalin ✓'; }, function () { $('link').focus(); });
  };
  load();

  /* ---- role access ---- */
  var CAT = JSON.parse($('catalog').textContent);
  var roleById = {}, modById = {};
  CAT.ROLES.forEach(function (r) { roleById[r.id] = r; });
  CAT.MODS.forEach(function (m) { modById[m.id] = m; });
  var TYPE = { mod: 'Tambah modul', role: 'Role tambahan', 'switch': 'Ganti role' };
  var el = function (tag, text, css) { var e = document.createElement(tag); if (text != null) e.textContent = text; if (css) e.style.cssText = css; return e; };
  var cls = function (e, c) { e.className = c; return e; };
  var modLabel = function (id) { var m = modById[id]; return m ? m.code + ' · ' + m.title : id; };
  var targetName = function (r) { return r.type === 'mod' ? modLabel(r.target) : (roleById[r.target] ? roleById[r.target].t : r.target); };
  function adm(method, url, body) {
    var init = { method: method, credentials: 'same-origin', headers: { 'content-type': 'application/json' } };
    if (body) init.body = JSON.stringify(body);
    return fetch(url, init).then(function (r) {
      if (r.status === 401) { location.href = '/login'; throw 0; }
      if (r.status === 403) { $('denied').hidden = false; $('panel').hidden = true; $('reqCard').hidden = true; $('usrCard').hidden = true; throw 0; }
      return r.json().catch(function () { return {}; }).then(function (d) { if (!r.ok) throw new Error(d.error || ''); return d; });
    });
  }
  var when = function (t) { return new Date(t).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }); };
  function notifs(d) {
    renderReqs(d.requests); renderRdms(d.redemptions);
    var n = d.requests.length + d.redemptions.filter(function (r) { return !r.done; }).length;
    $('ncount').textContent = n || '';
    document.title = (n ? '(' + n + ') ' : '') + 'Admin · Akademi SAP';
  }
  function reload() {
    return adm('GET', '/api/admin/users').then(function (d) {
      ['reqCard', 'usrCard', 'cpnCard', 'waCard'].forEach(function (id) { $(id).hidden = false; });
      notifs(d); renderUsers(d.users);
      if (document.activeElement !== $('waNum')) $('waNum').value = (d.settings && d.settings.wa) || '';
      return loadCoupons();
    }).catch(fail);
  }
  // Poll only the notification lists so an open user editor is not reset.
  setInterval(function () {
    if (document.hidden) return;
    adm('GET', '/api/admin/users').then(notifs).catch(function () {});
  }, 30000);
  function renderRdms(list) {
    var box = $('rdms'); box.textContent = '';
    var open = list.filter(function (r) { return !r.done; }), done = list.filter(function (r) { return r.done; });
    if (!open.length) box.append(cls(el('p', 'Tidak ada penukaran baru.', 'margin:0'), 'meta'));
    var row = function (r) {
      var rw = cls(el('div'), 'arow' + (r.done ? ' done' : ''));
      var info = cls(el('div'), 'grow');
      info.append(el('strong', r.user), el('div', r.t + ' · ' + r.cost + ' koin' + (r.coupon ? ' · kupon ' + r.coupon : '')),
        cls(el('div', r.id + ' · ' + when(r.at) + (r.done ? ' · selesai ' + when(r.doneAt) : '')), 'sub'));
      rw.append(info);
      if (!r.done) {
        var b = cls(el('button', 'Tandai selesai'), 'btn'); b.type = 'button';
        b.onclick = function () { b.disabled = true; adm('POST', '/api/admin/redemptions/' + encodeURIComponent(r.id), { action: 'done' }).catch(fail).then(reload); };
        rw.append(b);
      }
      return rw;
    };
    open.forEach(function (r) { box.append(row(r)); });
    if (done.length) {
      var det = el('details'); det.append(el('summary', 'Riwayat selesai (' + done.length + ')', 'cursor:pointer;min-height:44px;display:flex;align-items:center;font-size:14px'));
      done.slice(0, 50).forEach(function (r) { det.append(row(r)); });
      box.append(det);
    }
  }
  function loadCoupons() {
    return adm('GET', '/api/admin/coupons').then(function (d) {
      var box = $('cpns'); box.textContent = '';
      if (!d.coupons.length) { box.append(cls(el('p', 'Belum ada kupon.', 'margin:12px 0 0'), 'meta')); return; }
      d.coupons.forEach(function (c) {
        var rw = cls(el('div'), 'arow' + (c.usedBy ? ' done' : ''));
        var info = cls(el('div'), 'grow');
        var code = el('code', c.code, 'user-select:all;font-weight:700');
        info.append(code, el('div', c.reward + ' · ' + c.cost + ' koin'), cls(el('div', c.usedBy ? 'Dipakai ' + c.usedBy + ' · ' + when(c.usedAt) : 'Belum dipakai · dibuat ' + when(c.at)), 'sub'));
        rw.append(info);
        if (!c.usedBy) {
          var del = cls(el('button', 'Hapus'), 'btn ghost'); del.type = 'button';
          del.onclick = function () { del.disabled = true; adm('DELETE', '/api/admin/coupons?code=' + encodeURIComponent(c.code)).catch(fail).then(loadCoupons); };
          rw.append(del);
        }
        box.append(rw);
      });
    }).catch(fail);
  }
  $('cpnForm').onsubmit = function (e) {
    e.preventDefault(); $('msg').textContent = '';
    var b = $('cpnForm').querySelector('button'); b.disabled = true;
    adm('POST', '/api/admin/coupons', { reward: $('cpnReward').value, cost: Number($('cpnCost').value), code: $('cpnCode').value.trim() || undefined })
      .then(function () { $('cpnForm').reset(); return loadCoupons(); }).catch(fail).then(function () { b.disabled = false; });
  };
  $('waForm').onsubmit = function (e) {
    e.preventDefault(); $('waSt').textContent = '';
    adm('PUT', '/api/admin/settings', { wa: $('waNum').value }).then(function (d) {
      $('waNum').value = d.wa; $('waSt').textContent = d.wa ? 'Tersimpan ✓ wa.me/' + d.wa : 'WhatsApp dimatikan';
    }).catch(function (x) { if (x !== 0) $('waSt').textContent = x.message || 'Gagal menyimpan'; });
  };
  // Per-user EXP, coins and redemptions (read-only).
  function detail(u) {
    var d = cls(el('div'), ''); d.append(cls(el('p', 'Memuat rincian…', 'margin:0 0 8px'), 'meta'));
    adm('GET', '/api/admin/users/' + encodeURIComponent(u.name)).then(function (x) {
      d.textContent = '';
      var addOn = (x.roles || []).map(function (id) { return roleById[id] ? roleById[id].t : id; }).concat((x.mods || []).map(modLabel));
      d.append(el('p', 'Role: ' + (x.role && roleById[x.role] ? roleById[x.role].t : 'belum pilih') + (addOn.length ? ' · Add-on: ' + addOn.join(', ') : ' · Tanpa add-on'), 'margin:0 0 10px;font-size:14px'));
      var st = cls(el('div'), 'stats');
      var stat = function (v, t) { var b = el('div'); b.append(el('b', v), el('span', t)); st.append(b); };
      var n = function (v) { return Number(v || 0).toLocaleString('id-ID'); };
      stat(x.xp ? n(x.xp.total) : '–', 'EXP sekarang');
      stat(n(x.wallet.earned), 'Koin didapat');
      stat(n(x.wallet.spent), 'Koin dipakai');
      stat(n(x.wallet.coins), 'Saldo koin');
      d.append(st);
      if (x.xp) {
        var t = cls(el('table'), 'xtbl');
        [['Modul', x.xp.mod, x.xp.modMax], ['Praktik & ujian role', x.xp.role, x.xp.roleMax], ['Flashcard', (x.xp.cardH || 0) + (x.xp.cardO || 0), x.xp.cardMax], ['Misi Simulator bebas', x.xp.free, x.xp.freeMax], ['EXP belum ditukar', x.xp.avail, null]].forEach(function (r) {
          var tr = el('tr'); tr.append(el('td', r[0]), el('td', n(r[1]) + (r[2] != null ? ' / ' + n(r[2]) : ''))); t.append(tr);
        });
        d.append(t);
      } else d.append(cls(el('p', 'Rincian EXP muncul setelah peserta membuka aplikasi lagi.', 'margin:0 0 10px'), 'meta'));
      d.append(el('div', 'Penukaran', 'font-weight:500;margin:4px 0'));
      if (!x.redeemed.length) d.append(cls(el('p', 'Belum ada.', 'margin:0 0 8px'), 'meta'));
      x.redeemed.forEach(function (r) {
        d.append(cls(el('div', r.code + ' · ' + r.t + ' · ' + r.cost + ' koin · ' + when(r.at) + (r.done ? ' · selesai' : ' · menunggu'), 'padding:4px 0;font-size:14px'), r.done ? 'done' : ''));
      });
      var rs = cls(el('button', 'Reset password'), 'btn ghost'); rs.type = 'button'; rs.style.marginTop = '10px';
      var out = el('p', null, 'margin:8px 0 0;font-size:14px');
      rs.onclick = function () {
        if (rs.textContent !== 'Yakin reset?') { rs.textContent = 'Yakin reset?'; return; }
        rs.disabled = true; $('msg').textContent = '';
        adm('POST', '/api/admin/users/' + encodeURIComponent(u.name)).then(function (r) {
          out.textContent = 'Password sementara: ';
          out.append(el('code', r.password, 'user-select:all;font-weight:700'), el('br'), 'Kirim ke user, minta dia ganti lewat menu Ganti password.');
        }).catch(fail).then(function () { rs.disabled = false; rs.textContent = 'Reset password'; });
      };
      d.append(rs, out);
    }).catch(function (e) { d.textContent = ''; fail(e); });
    return d;
  }
  function renderReqs(reqs) {
    var box = $('reqs'); box.textContent = '';
    if (!reqs.length) { box.append(cls(el('p', 'Tidak ada permintaan.', 'margin:0'), 'meta')); return; }
    reqs.forEach(function (r) {
      var row = cls(el('div'), 'arow');
      var info = cls(el('div'), 'grow');
      info.append(el('strong', r.user), el('div', (TYPE[r.type] || r.type) + ': ' + targetName(r)),
        cls(el('div', new Date(r.at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' })), 'sub'));
      var act = function (label, action, kind) {
        var b = cls(el('button', label), 'btn' + (kind ? ' ' + kind : '')); b.type = 'button';
        b.onclick = function () {
          $('msg').textContent = ''; row.querySelectorAll('button').forEach(function (x) { x.disabled = true; });
          adm('POST', '/api/admin/requests/' + encodeURIComponent(r.id), { action: action }).catch(fail).then(reload);
        };
        return b;
      };
      row.append(info, act('Setujui', 'approve'), act('Tolak', 'reject', 'ghost'));
      box.append(row);
    });
  }
  function renderUsers(users) {
    var box = $('usrs'); box.textContent = '';
    users.forEach(function (u) {
      var wrap = el('div');
      var row = cls(el('div'), 'arow');
      var info = cls(el('div'), 'grow');
      var nm = el('strong', u.name);
      if (u.admin) nm.append(cls(el('span', 'admin'), 'abadge'));
      var counts = [];
      if ((u.roles || []).length) counts.push('+' + u.roles.length + ' role');
      if ((u.mods || []).length) counts.push('+' + u.mods.length + ' modul');
      info.append(nm, cls(el('div', (u.role && roleById[u.role] ? roleById[u.role].t : 'Belum pilih role') + (counts.length ? ' · ' + counts.join(' · ') : '')), 'sub'));
      var open = cls(el('button', 'Detail & atur'), 'btn ghost'); open.type = 'button';
      row.append(info, open);
      var ed = null;
      row.onclick = function () {
        if (ed) { ed.remove(); ed = null; return; }
        ed = editor(u); wrap.append(ed);
      };
      wrap.append(row); box.append(wrap);
    });
  }
  function editor(u) {
    var d = cls(el('div'), 'aedit');
    d.append(detail(u));
    if (u.admin) { d.append(el('p', 'Admin: akses semua modul', 'margin:0')); return d; }
    var sel = el('select'); sel.append(new Option('Belum pilih role', ''));
    var f1 = el('fieldset'); f1.append(el('legend', 'Role utama'), sel);
    var f2 = el('fieldset'); f2.append(el('legend', 'Role tambahan'));
    var f3 = el('fieldset'); f3.append(el('legend', 'Modul tambahan'));
    var roleBoxes = {}, modBoxes = {}, hints = {}, own = {};
    CAT.RGRP.forEach(function (g) {
      var rs = CAT.ROLES.filter(function (r) { return r.grp === g[0]; });
      if (!rs.length) return;
      var og = document.createElement('optgroup'); og.label = g[1];
      rs.forEach(function (r) { og.append(new Option(r.t, r.id)); });
      sel.append(og);
      f2.append(cls(el('div', g[1]), 'grp'));
      rs.forEach(function (r) {
        var l = el('label'), c = document.createElement('input'); c.type = 'checkbox'; c.value = r.id;
        c.checked = (u.roles || []).indexOf(r.id) >= 0; c.onchange = sync;
        roleBoxes[r.id] = c; l.append(c, r.t); f2.append(l);
      });
    });
    sel.value = u.role || '';
    CAT.CATS.forEach(function (ct) {
      var ms = CAT.MODS.filter(function (m) { return m.cat === ct.id; });
      if (!ms.length) return;
      f3.append(cls(el('div', ct.t), 'grp'));
      ms.forEach(function (m) {
        var l = el('label'), c = document.createElement('input'); c.type = 'checkbox'; c.value = m.id;
        c.checked = own[m.id] = (u.mods || []).indexOf(m.id) >= 0; c.onchange = sync;
        var hint = cls(el('span', '· dari role'), 'from'); hint.hidden = true;
        modBoxes[m.id] = c; hints[m.id] = hint; l.append(c, m.code + ' · ' + m.title, hint); f3.append(l);
      });
    });
    function sync() {
      var primary = sel.value, covered = {};
      Object.keys(roleBoxes).forEach(function (id) {
        roleBoxes[id].disabled = id === primary;
        if (id === primary) roleBoxes[id].checked = false;
      });
      // remember the user's own choice for modules not currently covered by a role
      Object.keys(modBoxes).forEach(function (id) { if (!modBoxes[id].disabled) own[id] = modBoxes[id].checked; });
      [primary].concat(Object.keys(roleBoxes).filter(function (id) { return roleBoxes[id].checked; })).forEach(function (id) {
        var r = roleById[id]; if (r) [].concat(r.w, r.g, r.p).forEach(function (m) { covered[m] = 1; });
      });
      Object.keys(modBoxes).forEach(function (id) {
        modBoxes[id].disabled = !!covered[id]; hints[id].hidden = !covered[id];
        modBoxes[id].checked = covered[id] ? true : own[id];
      });
    }
    sel.onchange = sync; sync();
    var save = cls(el('button', 'Simpan'), 'btn'); save.type = 'button';
    var st = cls(el('span', ''), 'st');
    save.onclick = function () {
      var body = {
        role: sel.value || null,
        roles: Object.keys(roleBoxes).filter(function (id) { return roleBoxes[id].checked; }),
        mods: Object.keys(modBoxes).filter(function (id) { return !modBoxes[id].disabled && modBoxes[id].checked; })
      };
      save.disabled = true; st.textContent = ''; $('msg').textContent = '';
      adm('PUT', '/api/admin/users/' + encodeURIComponent(u.name), body).then(function () {
        st.textContent = 'Tersimpan ✓'; return reload();
      }).catch(function (e) { fail(e); save.disabled = false; });
    };
    d.append(f1, f2, f3, save, st);
    return d;
  }
  reload();
</script>
</body>
</html>
